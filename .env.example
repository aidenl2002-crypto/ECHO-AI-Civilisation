# ---- ECHO BRAIN: OpenCode CLI is the primary AI gateway ----
OPENCODE_ENABLED=true
OPENCODE_EXE=opencode
OPENCODE_MODEL=opencode/space-bunny-free
OPENCODE_TIMEOUT_MS=60000
OPENCODE_CONCURRENCY=3
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_CWD=runtime/opencode-brain
AI_INTENSITY=0.5
AI_COOLDOWN_MS=30000
AI_NARRATIVE=true
AI_BACKGROUND=true


# API
PORT=4000
DB_PATH=./data/echo.db
# Set DATABASE_URL to use Postgres instead of SQLite, e.g.:
# DATABASE_URL=postgres://echo:echo@localhost:5432/echo

# World defaults (deterministic seed)
CITY_NAME="Echo City"
WORLD_SEED=1337
START_CITIZENS=120

# ---- OWNER GOD CONSOLE ----
# OWNER_TOKEN unlocks /control + ALL /api/admin/* (default "owner-dev" if unset).
OWNER_TOKEN=owner-dev
# ADMIN_TOKENS=all powers except system.database. OBSERVER_TOKENS=read-only + ai.inspect.
# ADMIN_TOKENS=adm1,adm2
# OBSERVER_TOKENS=obs1
# USER_TOKENS=u1
